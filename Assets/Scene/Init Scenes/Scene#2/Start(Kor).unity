  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 708705254, guid: f70555f144d8491a825f0804e09c671c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
    m_TypeName: UnityEngine.UI.MaskableGraphic+CullStateChangedEvent, UnityEngine.UI,
      Version=1.0.0.0, Culture=neutral, PublicKeyToken=null
  m_FontData:
    m_Font: {fileID: 12800000, guid: cb3b162d53c29e142be01fbfc3f6f1de, type: 3}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 145
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\uBA85\uD655\uD55C \uBE44\uC804\uACFC \uB3C4\uC57D\uC774 \uC788\uB294 \uACF3!
    \uAD6D\uB9BD\uC778\uCC9C\uB300\uD559\uAD50\uB97C \uBC29\uBB38\uD574 \uC8FC\uC154\uC11C
    \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\n\n\uC6B0\uB9AC\uB300\uD559\uC740 \uACF5\uACFC\uB300\uD559\uC73C\uB85C
    \uC2DC\uC791\uD558\uC5EC \uC885\uD569\uB300, \uC2DC\uB9BD\uB300, \uAD6D\uB9BD\uB300\uB85C
    \uC9E7\uC740 \uAE30\uAC04 \uB2E4\uC591\uD55C \uC5ED\uC0AC\uB97C \uAC04\uC9C1\uD574
    \uC624\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC1A1\uB3C4\uB77C\uB294 \uD0C1\uC6D4\uD55C
    \uC9C0\uB9AC\uC801 \uD2B9\uC131\uACFC 4\uCC28\uC0B0\uC5C5\uC2DC\uB300\uC5D0 \uC54C\uB9DE\uB294
    \uCD5C\uCCA8\uB2E8 \uCEA0\uD37C\uC2A4\uB97C \uC99D\uAC15\uD604\uC2E4\uC744 \uC774\uC6A9\uD55C
    INU AR Tour\uB97C \uD1B5\uD574 \uB458\uB7EC\uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\n\n\uB2F9\uC2E0\uC744
    \uAE68\uC6B0\uB294 \uB300\uD559, \uAD6D\uB9BD\uC778\uCC9C\uB300\uD559\uAD50 "
