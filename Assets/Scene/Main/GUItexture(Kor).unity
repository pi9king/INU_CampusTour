--- !u!114 &1331942002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1331942000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 708705254, guid: f70555f144d8491a825f0804e09c671c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
    m_TypeName: UnityEngine.UI.MaskableGraphic+CullStateChangedEvent, UnityEngine.UI,
      Version=1.0.0.0, Culture=neutral, PublicKeyToken=null
  m_FontData:
    m_Font: {fileID: 12800000, guid: 41e2381d5d932f745a1ceb9166ca2f7d, type: 3}
    m_FontSize: 25
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.27
  m_Text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C!\n\uAFC8\uACFC \uD76C\uB9DD\uC744
    \uB4DC\uB9AC\uB294 \uAD6D\uB9BD \uC778\uCC9C\uB300\uD559\uAD50 \uD64D\uBCF4\uB300\uC0AC
    \uB4DC\uB9BC\uC774\uC785\uB2C8\uB2E4!\n\uC778\uCC9C\uB300\uD559\uAD50\uB294 \uBCC4\uC5D0\uC11C\uC628\uADF8\uB300,
    \uB7F0\uB2DD\uB9E8, \uC544\uC774\uB9AC\uC2A42 \uB4F1 \uC218 \uB9CE\uC740 \uB4DC\uB77C\uB9C8\uB97C
    \uCD2C\uC601\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC54C\uACE0 \uACC4\uC2E0\uAC00\uC694?\n\uBCF8
    \uD22C\uC5B4\uCF54\uC2A4\uC5D0\uC11C\uB294 \uC778\uCC9C\uB300\uD559\uAD50 \uB0B4\uC5D0\uC11C
    \uCD2C\uC601\uD588\uB358 \uACF3\uC744 \uC9C1\uC811 \uB4E4\uB9AC\uACE0 \uC8FC\uBCC0
    \uACBD\uAD00\uC744 \uB458\uB7EC\uBCF4\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uB7FC
    \uD22C\uC5B4\uB97C \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4!!\n"
