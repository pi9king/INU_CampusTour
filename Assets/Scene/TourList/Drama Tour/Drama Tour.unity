    m_LineSpacing: 1
  m_Text: "\uB7F0\uB2DD\uB9E8\n\uD3B8\uC131\r\nSBS 2010.07.11. ~ \uBC29\uC601\uC911|(\uC77C)
    \uC624\uD6C4 04:50\n\uB7F0\uB2DD\uB9E8\uC774 \uBAB8\uC73C\uB85C \uC9C1\uC811 \uC54C\uB824\uB4DC\uB9AC\uB294
    \uB300\uD55C\uBBFC\uAD6D \uB300\uD45C \uB79C\uB4DC\uB9C8\uD06C! \uB300\uD55C\uBBFC\uAD6D
    \uCD5C\uACE0\uC758 \uC5F0\uC608\uC778\uB4E4\uC774 \uADF8\uACF3\uC5D0 \uBAA8\uC600\uB2E4!
