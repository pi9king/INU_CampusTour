    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "\n15\uD638\uAD00 \uC778\uBB38\uB300\uD559\uC740 \uAD6D\uC5B4\uAD6D\uBB38\uD559\uACFC,
    \uC601\uC5B4\uC601\uBB38\uD559\uACFC, \uB3C5\uC5B4\uB3C5\uBB38\uD559\uACFC, \uBD88\uC5B4\uBD88\uBB38\uD559\uACFC,
    \uC77C\uC5B4\uC77C\uBB38\uD559\uACFC, \uC911\uC5B4\uC911\uAD6D\uD559\uACFC\uAC00
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB2E4\uB978 \uC5B4\uBB38\uACC4\uC5F4\uD559\uACFC\uC640
    \uB2EC\uB9AC \uC911\uC5B4\uC911\uAD6D\uD559\uACFC\uC5D0\uC11C\uB294 \uC911\uAD6D\uC758
    \uC815\uCE58, \uACBD\uC81C, \uC5ED\uC0AC, \uBB38\uD654 \uB4F1 \uC911\uAD6D \uC804\uBC18\uC5D0
    \uB300\uD574 \uBC30\uC6C1\uB2C8\uB2E4.\r\n"
