    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "\n\n\uC6B0\uB9AC \uC778\uCC9C\uB300\uB294 1979\uB144 \uAC1C\uAD50\uD558\uC600\uACE0
    \uC0AC\uB9BD\uB300-\uC2DC\uB9BD\uB300-\uAD6D\uB9BD\uB300\uB85C \uBC1C\uC804\uD55C
    \uAD6D\uB0B4 \uC720\uC77C\uC758 \uB300\uD559\uC785\uB2C8\uB2E4.\r\n\uB300\uD559\uBCF8\uBD80\uC5D0\uB294
    \uCD1D\uC7A5\uC2E4\uC744 \uD3EC\uD568\uD55C \uC8FC\uC694 \uD589\uC815\uBD80\uC11C\uAC00
    \uC704\uCE58\uD574 \uC788\uC2B5\uB2C8\uB2E4. \n\uAC00\uC6B4\uB370\uAC00 \uB6AB\uB9B0
    \uAC83\uC740 \uB3C4\uC2DC\uC601\uC5ED(\uC1A1\uB3C4\uAD6D\uC81C\uB3C4\uC2DC)\uACFC
    \uAD50\uC721\uC601\uC5ED(\uCEA0\uD37C\uC2A4)\uC744 \uC18C\uD1B5\uACFC \uAD50\uB958\uD558\uB3C4\uB85D
    \uC774\uC5B4\uC8FC\uB294 \uBB38(gate)\uC744 \uD615\uC0C1\uD654\uD55C \uAC83\uC785\uB2C8\uB2E4.
    \n"
