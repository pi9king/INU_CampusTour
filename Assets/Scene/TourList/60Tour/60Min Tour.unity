    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "14\uD638\uAD00 \uACBD\uC601\uB300\uD559\uC5D0\uB294 \uACBD\uC601\uD559\uBD80,
    \uC138\uBB34\uD68C\uACC4\uD559\uACFC\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uACBD\uC601\uB300\uD559\uC740
    \uC778\uCC9C\uB300 \uCD08\uCC3D\uAE30\uBD80\uD130 \uC5ED\uC0AC\uC640 \uC804\uD1B5\uC744
    \uD568\uAED8\uD574 \uC628 \uB300\uD559\uC785\uB2C8\uB2E4. \r\n1979\uB144 \uACBD\uC601\uD559\uACFC(\uC8FC\u2024\uC57C)\uAC00
    \uC124\uB9BD\uB418\uC5B4 1988\uB144 \uACBD\uC0C1\uB300\uD559\uC73C\uB85C \uC2B9\uACA9\uB418\uC5C8\uACE0,
    2006\uB144 \uACBD\uC601\uB300\uD559\uC73C\uB85C \uBA85\uCE6D\uC774 \uBCC0\uACBD\uB418\uAE30\uAE4C\uC9C0
    3\uAC1C \uD559\uACFC\uC640 \uC804\uACF5\uC774 \uC2E0\uC124, \uBD84\uB9AC\uB418\uB294
    \uACFC\uC815\uC744 \uAC70\uCCD0, \uD604\uC7AC \uACBD\uC601\uB300\uD559\uC5D0\uB294
    \uACBD\uC601\uD559\uBD80 1\uAC1C \uD559\uBD80\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\r\n"
