    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "8\uD638\uAD00 \uACF5\uACFC\uB300\uD559\uC740 1979\uB144 \uC778\uCC9C\uB300\uD559\uAD50\uC758
    \uBAA8\uCCB4\uC778 \uC778\uCC9C\uACF5\uACFC\uB300\uD559\uC73C\uB85C \uAC1C\uAD50\uD560
    \uB2F9\uC2DC 5\uAC1C \uD559\uACFC\uB85C \uC2DC\uC791 \uD558\uC600\uC73C\uBA70,
    \uD604\uC7AC \uC6B0\uB9AC \uB300\uD559\uC5D0\uC11C \n\uAC00\uC7A5 \uD070 \uADDC\uBAA8\uC758
    \uB2E8\uACFC\uB300\uD559\uC785\uB2C8\uB2E4.\r\n\uACF5\uACFC\uB300\uD559\uC5D0\uB294
    \uAE30\uACC4\uACF5\uD559\uACFC, \uBA54\uCE74\uD2B8\uB85C\uB2C9\uC2A4\uACF5\uD559\uACFC,
    \uC804\uAE30\uACF5\uD559\uACFC, \uC804\uC790\uACF5\uD559\uACFC, \uC0B0\uC5C5\uACBD\uC601\uACF5\uD559\uACFC,
    \uC2E0\uC18C\uC7AC\uACF5\uD559\uACFC, \uC548\uC804\uACF5\uD559\uACFC, \uC5D0\uB108\uC9C0\uD654\uD559\uACF5\uD559\uACFC\uAC00
    \uC788\uC2B5\uB2C8\uB2E4.\r\n"
