  m_Text: "\n\uAE00\uB85C\uBC8C\uBC95\uC815\uACBD\uB300\uD559\uC5D0\uB294 \uBC95\uD559\uBD80,
    \uD589\uC815\uD559\uACFC, \uC815\uCE58\uC678\uAD50\uD559\uACFC, \uACBD\uC81C\uD559\uACFC,
    \uBB34\uC5ED\uD559\uBD80\uAC00 \uC704\uCE58\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uAE00\uB85C\uBC8C\uBC95\uC815\uACBD\uB300\uD559\uC740
