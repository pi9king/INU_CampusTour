    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "\uC0AC\uD68C\uACFC\uD559\uB300\uD559\uC740 \uC0AC\uD68C\uBCF5\uC9C0\uD559\uACFC,
    \uC2E0\uBB38\uBC29\uC1A1\uD559\uACFC, \uBB38\uD5CC\uC815\uBCF4\uD559\uACFC, \uCC3D\uC758\uC778\uC7AC\uAC1C\uBC1C\uD559\uACFC\uAC00
    \uC788\uC2B5\uB2C8\uB2E4. \uC0AC\uD68C\uACFC\uD559\uB300\uD559\uC740 \uCC3D\uC870\uC801
    \uAD50\uC721\uD601\uC2E0\uC744 \uD1B5\uD574 \uC0AC\uD68C\uACFC\uD559\uC801 \uC2DD\uACAC\uACFC
    \uBD84\uC57C\uBCC4 \uC804\uBB38\uC9C0\uC2DD\uC744 \uAC16\uCD98 21\uC138\uAE30
    \uAE00\uB85C\uBC8C \uB9AC\uB354\uB97C \uC591\uC131\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n"
