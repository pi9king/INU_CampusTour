    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "7\uD638\uAD00 \uC815\uBCF4\uAE30\uC220\uB300\uD559\uC740 \uCEF4\uD4E8\uD130\uACF5\uD559\uBD80,
    \uC815\uBCF4\uD1B5\uC2E0\uACF5\uD559\uACFC, \uC784\uBCA0\uB514\uB4DC\uC2DC\uC2A4\uD15C\uACF5\uD559\uACFC\uAC00
    \uC704\uCE58\uD558\uACE0 \uC788\uC73C\uBA70, \uCC3D\uC758\uC801 \uB2A5\uB825\uACFC
    \uC778\uC131\uC744 \uAC16\uCD98 IT \uC804\uBB38\uAC00\uB97C \uC591\uC131\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uD2B9\uD788 \uC784\uBCA0\uB514\uB4DC\uC2DC\uC2A4\uD15C\uACF5\uD559\uACFC\uB294
    \uC804\uC790\uACF5\uD559\uACFC\uC640 \uCEF4\uD4E8\uD130\uACF5\uD559\uBD80\uC758
    \uCEE4\uB9AC\uD058\uB7FC\uC744 \uAC16\uACE0 \uC788\uC73C\uBA70 IoT(\uC0AC\uBB3C\uC778\uD130\uB137)
    \uB4F1\uC5D0 \uB300\uD574 \uBC30\uC6C1\uB2C8\uB2E4.\r\n"
