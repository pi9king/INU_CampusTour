    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "6\uD638\uAD00 \uD559\uC0B0\uB3C4\uC11C\uAD00\uC740 \uC9C0\uD5581\uCE35,
    \uC9C0\uC0C1 4\uCE35 \uADDC\uBAA8\uB85C 1,800\uC11D\uC758 \uC5F4\uB78C\uC11D\uACFC
    120\uB9CC\uAD8C\uC758 \uC7A5\uC11C\uB97C \uAC16\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
    \uBCF8\uAD50 \uD559\uC0DD\uB4E4 \uBFD0 \uC544\uB2C8\uB77C \uC878\uC5C5\uC0DD,
    \uC778\uCC9C\uC2DC\uBBFC\uB3C4 \uC774\uC6A9\uC774 \uAC00\uB2A5\uD558\uBA70, \uC790\uC138\uD55C
    \uC0AC\uD56D\uC740 \uD559\uC0B0\uB3C4\uC11C\uAD00 \uD648\uD398\uC774\uC9C0\uC5D0\uC11C
    \uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
