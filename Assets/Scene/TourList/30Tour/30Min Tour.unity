    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.6
  m_Text: "16\uD638\uAD00 \uC608\uC220\uCCB4\uC721\uB300\uD559\uC740 \uC870\uD615\uC608\uC220\uD559\uBD80(\uD55C\uAD6D\uD654,
    \uC11C\uC591\uD654), \uB514\uC790\uC778\uD559\uBD80, \uACF5\uC5F0\uC608\uC220\uD559\uACFC,
    \uCCB4\uC721\uD559\uBD80, \uC6B4\uB3D9\uAC74\uAC15\uD559\uBD80\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \r\n\uCCB4\uC721\uD559\uBD80 \uD559\uC0DD\uB4E4\uB85C \uAD6C\uC131\uB41C \uC778\uCC9C\uB300
    \uCD95\uAD6C\uBD80\uB294 \uC804\uAD6D\uCCB4\uC721\uB300\uD68C 3\uD68C \uC6B0\uC2B9,
    U\uB9AC\uADF8 2\uAD8C\uC5ED \uC6B0\uC2B9 \uB4F1 \uC6B0\uC218\uD55C \uC131\uC801\uC744
    \uAC70\uB450\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \r\n"
